{
  "name": "jadeview-docs-mcp",
  "version": "1.0.3",
  "description": "JadeView 文档 MCP 服务（stdio）：全文搜索 + 整页读取随包分发的 markdown 文档",
  "type": "module",
  "main": "dist/mcp.js",
  "bin": {
    "jadeview-docs-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "content",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync-content": "node scripts/sync-content.mjs",
    "test:client": "node test/client.mjs",
    "test:npx": "npm pack && node test/npx-sim.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jadeview",
    "docs",
    "search",
    "stdio"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
